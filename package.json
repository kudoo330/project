{
  "name": "a-share-tracker",
  "version": "0.5.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "test:browser": "playwright test",
    "test:scheduler": "node scripts/test-scheduler.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply tracker --local",
    "deploy": "node scripts/deploy-web.mjs",
    "password": "node scripts/password.mjs",
    "cloudflare:setup": "node scripts/cloudflare-setup.mjs",
    "test:import": "node scripts/test-reviewed-import.mjs",
    "test:read-access": "node scripts/test-read-access.mjs",
    "test:close-import": "node scripts/test-close-import.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.0-beta"
  }
}
