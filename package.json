{
  "name": "a-share-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test --test-isolation=none test/*.test.ts",
    "test:browser": "playwright test",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:local": "wrangler d1 migrations apply tracker --local",
    "deploy": "wrangler deploy",
    "password": "node scripts/password.mjs"
    ,"cloudflare:setup": "node scripts/cloudflare-setup.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@playwright/test": "^1.64.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.0.0"
  }
}
